# Copie para swipe/.env (fora do git).
# Endereco do servico web do Swipe Purge (a rota /api/postiz/chaves fica nele, fora do Cloudflare Access)
# e o token colado em Integracoes > Postiz.
ADMIN_URL=https://admin.swipepurge.me
POSTIZ_ADMIN_TOKEN=
# Segredo de login local, gere com: openssl rand -hex 32
JWT_SECRET=
